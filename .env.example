# Kopiér til .env og udfyld. .env må aldrig committes (står i .gitignore).
# Lav stærke nøgler med:  python -c "import secrets; print(secrets.token_urlsafe(24))"

DEVICE_API_KEY=
OPERATOR_API_KEY=

MYSQL_DATABASE=alarm_service
MYSQL_USER=alarm_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

ALARM_EMAIL_FROM=alarm@intelligent-iot.example
ALARM_EMAIL_TO=vagt@intelligent-iot.example
# Kun i drift med rigtig SMTP:
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

RATE_LIMIT=120 per minute
LOG_LEVEL=INFO

# Grafana (bruger: admin)
GRAFANA_ADMIN_PASSWORD=
